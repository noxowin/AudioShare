<Window x:Class="AudioShare.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AudioShare.App.ViewModels"
        xmlns:local="clr-namespace:AudioShare.App"
        Title="AudioShare"
        Width="600" Height="860" MinWidth="500" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InvertBoolConverter x:Key="Invert" />

        <!-- 设置项的一行：左边标题 + 说明，右边控件 -->
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- 设备卡片里控件行左侧的小标题 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 快捷键键帽 -->
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="DeviceTemplate" DataType="{x:Type vm:DeviceViewModel}">
            <Border x:Name="CardRoot" Style="{StaticResource Card}" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 设备图标：圆角方块底色，打开后变成主题色 -->
                    <Border x:Name="IconBadge" Width="40" Height="40" CornerRadius="10" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Background="{StaticResource ControlBrush}">
                        <TextBlock x:Name="Icon" Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource SubTextBrush}" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       MaxWidth="320" ToolTip="{Binding Name}" />
                            <Border x:Name="SourcePill" Style="{StaticResource Pill}" Margin="8,0,0,0"
                                    Background="{StaticResource SuccessSoftBrush}" Visibility="Collapsed">
                                <TextBlock Text="{Binding DataContext.SourceBadge, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="11" Foreground="{StaticResource SuccessBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="StatusLine" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Status, Mode=OneWay}" />
                            <Run Text=" · " Foreground="{StaticResource TertiaryTextBrush}" />
                            <Run Text="{Binding Format, Mode=OneWay}" Foreground="{StaticResource TertiaryTextBrush}" />
                        </TextBlock>
                    </StackPanel>

                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                              IsChecked="{Binding IsEnabled}" IsEnabled="{Binding CanToggle}"
                              ToolTip="在这个设备上同时播放" />

                    <ProgressBar x:Name="Meter" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource LevelMeter}"
                                 Margin="0,12,0,0" Value="{Binding Level, Mode=OneWay}" Visibility="Collapsed" />

                    <!-- 打开后才出现的调节区 -->
                    <Grid x:Name="Controls" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="音量" Style="{StaticResource FieldLabel}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="200" Value="{Binding Volume}"
                                SmallChange="1" LargeChange="10" ToolTip="这个设备的音量，超过 100% 是增强（自带防爆音）" />
                        <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0:0}%}" Style="{StaticResource ValueText}" />

                        <TextBlock Grid.Row="1" Text="延迟" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" />
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="500" Value="{Binding DelayMs}" Margin="0,6,0,0"
                                SmallChange="5" LargeChange="50"
                                ToolTip="让这个设备晚一点出声，用来和蓝牙等延迟较高的设备对齐" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DelayMs, StringFormat={}+{0:0} ms}" Margin="0,6,0,0"
                                   Style="{StaticResource ValueText}" />

                        <TextBlock Grid.Row="2" Text="单声道" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="左右合并，只戴一只耳机时用" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,12,0,0" />
                        <CheckBox Grid.Row="2" Grid.Column="2" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                  Margin="0,12,0,0" IsChecked="{Binding Mono}" />

                        <!-- 音效：点开才显示，保持卡片简洁 -->
                        <TextBlock Grid.Row="3" Text="音效" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                        <ToggleButton Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Cursor="Hand"
                                      HorizontalAlignment="Stretch" IsChecked="{Binding ShowEffects}"
                                      FocusVisualStyle="{StaticResource FocusRing}" ToolTip="低音、人声、高音">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent">
                                        <TextBlock Text="{Binding EffectsSummary}" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="Chevron" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                                   Foreground="{StaticResource SubTextBrush}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chevron" Property="Foreground" Value="{StaticResource TextBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Border x:Name="EffectsPanel" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0"
                                Padding="14,10" CornerRadius="8" Background="{StaticResource InsetBrush}" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="低音" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" Minimum="-12" Maximum="12" Value="{Binding BassDb}" SmallChange="1" LargeChange="3" />
                                <TextBlock Grid.Column="2" Text="{Binding BassDb, StringFormat={}{0:+0;-0;0} dB}" Style="{StaticResource ValueText}" />
                                <TextBlock Grid.Row="1" Text="人声" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="-12" Maximum="12" Value="{Binding MidDb}" SmallChange="1" LargeChange="3" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MidDb, StringFormat={}{0:+0;-0;0} dB}" Style="{StaticResource ValueText}" />
                                <TextBlock Grid.Row="2" Text="高音" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="-12" Maximum="12" Value="{Binding TrebleDb}" SmallChange="1" LargeChange="3" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding TrebleDb, StringFormat={}{0:+0;-0;0} dB}" Style="{StaticResource ValueText}" />
                                <Button Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,6,0,0"
                                        Style="{StaticResource SubtleButton}" Padding="8,4" Click="OnResetEffects" Tag="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="恢复默认" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ShowEffects}" Value="True">
                    <Setter TargetName="EffectsPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                    <Setter TargetName="Controls" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Meter" Property="Visibility" Value="Visible" />
                    <Setter TargetName="IconBadge" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSource}" Value="True">
                    <Setter TargetName="Controls" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Meter" Property="Visibility" Value="Visible" />
                    <Setter TargetName="SourcePill" Property="Visibility" Value="Visible" />
                    <Setter TargetName="IconBadge" Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="CardRoot" Property="BorderBrush" Value="#FF3F5A3B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter TargetName="StatusLine" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
                <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="CardRoot" Property="Background" Value="{StaticResource CardHoverBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ───────────── 顶栏：名字 + 页面切换 ───────────── -->
        <Grid Margin="24,14,24,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/app.ico" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center" />
                <TextBlock Text="AudioShare" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="NavDevices" GroupName="Nav" Style="{StaticResource SegmentButton}" IsChecked="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F5;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="设备" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource SegmentButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="设置" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═════════════ 设备页 ═════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsChecked, ElementName=NavDevices, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="24,0,20,24">

                <!-- 新版本提示 -->
                <Border Margin="0,0,0,12" Padding="16,12" CornerRadius="10" Background="#FF1B3443"
                        BorderBrush="#FF2F6A88" BorderThickness="1"
                        Visibility="{Binding Update.HasUpdate, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Update.BannerText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Update.Message}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Style="{StaticResource SubtleButton}" Click="OnUpdateDetails" Margin="0,0,2,0">
                                <TextBlock Text="更新内容" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource SubtleButton}" Click="OnSkipUpdate" Margin="0,0,8,0">
                                <TextBlock Text="跳过" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource AccentButton}" Padding="14,6" FontSize="13" Click="OnInstallUpdate"
                                    IsEnabled="{Binding Update.IsBusy, Converter={StaticResource Invert}}">
                                <TextBlock Text="立即更新" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ───────────── 状态 + 开始按钮 ───────────── -->
                <Border CornerRadius="12" Padding="20" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#FF2D2D2D" />
                                        <GradientStop Offset="1" Color="#FF272727" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="BorderBrush" Value="#FF3F5A3B" />
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Offset="0" Color="#FF263326" />
                                                <GradientStop Offset="1" Color="#FF272A27" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 状态圆：共享中变绿并有呼吸光圈 -->
                        <Grid Width="56" Height="56" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Ellipse RenderTransformOrigin="0.5,0.5" StrokeThickness="2" Opacity="0">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform />
                                </Ellipse.RenderTransform>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Stroke" Value="{StaticResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="PulseStoryboard">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.7" To="0" Duration="0:0:1.8" />
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                             From="1" To="1.35" Duration="0:0:1.8" />
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                             From="1" To="1.35" Duration="0:0:1.8" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="PulseStoryboard" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource ControlBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessSoftBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="24"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE74F;" />
                                        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Text" Value="&#xE995;" />
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HeroTitle}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" FontSize="13" Margin="0,3,0,0" />
                            <WrapPanel Margin="0,10,0,0">
                                <Border Style="{StaticResource Pill}" Margin="0,0,6,4">
                                    <TextBlock FontSize="11" Foreground="{StaticResource SubTextBrush}">
                                        <Run Text="{Binding EnabledCount, Mode=OneWay}" /><Run Text=" 台设备" />
                                    </TextBlock>
                                </Border>
                                <Border Style="{StaticResource Pill}" Margin="0,0,6,4">
                                    <TextBlock FontSize="11" Foreground="{StaticResource SubTextBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="直接模式" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AlignMode}" Value="True">
                                                        <Setter Property="Text" Value="对齐模式" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Border Style="{StaticResource Pill}" Margin="0,0,6,4">
                                    <TextBlock FontSize="11" Foreground="{StaticResource SubTextBrush}"
                                               Text="{Binding BaseLatencyMs, StringFormat='缓冲 {0:0} ms'}" />
                                </Border>
                            </WrapPanel>
                        </StackPanel>

                        <Button Grid.Column="2" Command="{Binding ToggleCommand}" VerticalAlignment="Center" Margin="16,0,0,0"
                                Padding="22,11" FontSize="15" ToolTip="快捷键 Ctrl+Alt+S">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE768;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Text" Value="&#xE71A;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding ToggleText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ───────────── 方案：一键切换 ───────────── -->
                <Grid Margin="0,24,0,10">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                        <TextBlock Text="方案" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="保存好的设备组合，点一下就切换" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="OnSavePreset" ToolTip="把当前所有设备的开关、音量、延迟保存成一个方案">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="保存当前" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ListBox ItemsSource="{Binding PresetNames}" SelectedItem="{Binding SelectedPreset}"
                         Background="Transparent" BorderThickness="0" Focusable="False"
                         KeyboardNavigation.TabNavigation="Once">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter />
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PresetNames.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Margin" Value="0,0,8,8" />
                            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                            <Setter Property="ToolTip" Value="切换到这个方案" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Chip" CornerRadius="16" Padding="14,6,6,6" BorderThickness="1"
                                                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Label" Text="{Binding}" VerticalAlignment="Center" FontSize="13" />
                                                <Button x:Name="Delete" Style="{StaticResource SubtleButton}" Padding="5,3" Margin="6,0,0,0"
                                                        Click="OnDeletePreset" Tag="{Binding}" ToolTip="删除这个方案"
                                                        Visibility="Hidden" Focusable="False">
                                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                                               Foreground="{StaticResource SubTextBrush}" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                                <Setter TargetName="Delete" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- 还没有方案时的提示 -->
                <Border CornerRadius="10" Padding="14,12" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PresetNames.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="还没有方案。调好下面的设备后点「保存当前」，以后一键切换，也可以用 Ctrl+Alt+数字键切换。"
                               Style="{StaticResource Caption}" />
                </Border>

                <!-- ───────────── 播放方式 ───────────── -->
                <TextBlock Text="播放方式" Style="{StaticResource SectionHeader}" Margin="0,22,0,10" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Margin="0,0,56,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="对齐模式" Style="{StaticResource RowTitle}" />
                                    <Border Style="{StaticResource Pill}" Margin="8,0,0,0" Background="{StaticResource AccentSoftBrush}">
                                        <TextBlock Text="推荐" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="所有设备播放同一份声音，可以用延迟滑块完全对齐，不会有回声"
                                           Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding AlignMode}" />
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <TextBlock Text="{Binding SourceTitle}" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{Binding SourceHint}" Style="{StaticResource Caption}" Margin="0,3,0,10" />
                        <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" />
                    </StackPanel>
                </Border>

                <!-- ───────────── 输出设备 ───────────── -->
                <Grid Margin="0,22,0,10">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,180,0">
                        <TextBlock Text="输出设备" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="打开开关，就会在这台设备上同时播放" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}" Click="OnCalibrate" Margin="0,0,6,0"
                                ToolTip="用麦克风自动测出每台设备的延迟，并自动对齐">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="自动校准" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Padding="9,6"
                                ToolTip="重新扫描设备">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource DeviceTemplate}" Focusable="False" />

                <!-- 没有设备时的提示 -->
                <Border Padding="20,24">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7F3;" FontFamily="{StaticResource IconFont}" FontSize="28" HorizontalAlignment="Center"
                                   Foreground="{StaticResource SubTextBrush}" />
                        <TextBlock Text="没有找到播放设备" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock Text="插上耳机、音箱或连接蓝牙耳机后，点右上角的刷新按钮" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═════════════ 设置页 ═════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsChecked, ElementName=NavSettings, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="24,0,20,24">

                <TextBlock Text="声音" Style="{StaticResource SectionHeader}" Margin="0,4,0,10" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="缓冲" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="越小越跟手，越大越稳。出现杂音时会自动调大；蓝牙耳机一般需要 40 ms 以上。"
                                   Style="{StaticResource Caption}" Margin="0,3,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="20" Maximum="300" Value="{Binding BaseLatencyMs}" SmallChange="5" LargeChange="20" />
                            <TextBlock Grid.Column="1" Text="{Binding BaseLatencyMs, StringFormat={}{0:0} ms}"
                                       Style="{StaticResource ValueText}" FontSize="13" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="常规" Style="{StaticResource SectionHeader}" Margin="0,22,0,10" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Margin="0,0,56,0">
                                <TextBlock Text="开机自动启动" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="开机后在托盘里运行，上次在共享就自动接着共享" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding AutoStartEnabled}" />
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid>
                            <StackPanel Margin="0,0,56,0">
                                <TextBlock Text="全局快捷键" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="窗口藏在托盘里也能用" Style="{StaticResource Caption}" Margin="0,3,0,8" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl" FontSize="11" /></Border>
                                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="Alt" FontSize="11" /></Border>
                                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="S" FontSize="11" /></Border>
                                    <TextBlock Text="开始 / 停止共享" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl" FontSize="11" /></Border>
                                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="Alt" FontSize="11" /></Border>
                                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="1 ~ 9" FontSize="11" /></Border>
                                    <TextBlock Text="切换到第 1 ~ 9 个方案" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding HotkeysEnabled}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="更新" Style="{StaticResource SectionHeader}" Margin="0,22,0,10" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="自动检查更新" Style="{StaticResource RowTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0">
                                <Run Text="{Binding Update.CurrentVersionText, Mode=OneWay}" />
                                <Run Text="  " />
                                <Run Text="{Binding Update.Message, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="OnCheckUpdate" Margin="0,0,16,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="立即检查" />
                        </Button>
                        <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  IsChecked="{Binding Update.CheckUpdates}" />
                    </Grid>
                </Border>

                <TextBlock Text="关闭窗口后 AudioShare 会继续在托盘里运行，右键托盘图标可以停止共享或退出。"
                           Style="{StaticResource Caption}" Foreground="{StaticResource TertiaryTextBrush}"
                           Margin="2,20,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
